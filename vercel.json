{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/cj-proxy/:path*",
      "destination": "/api/cj-proxy?path=:path*"
    },
    {
      "source": "/api/cj/connect",
      "destination": "/api/cj/connect"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
